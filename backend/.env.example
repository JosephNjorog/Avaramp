# ──────────────────────────────────────────────────────────────────────────────
# AvaRamp — Environment Variable Template
# Copy to .env and fill in real values. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# Neon PostgreSQL — https://console.neon.tech → Connection string
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Redis — local or Upstash
REDIS_URL=redis://localhost:6379

# Avalanche
AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
GLACIER_API_KEY=
# Funds gas top-ups for settlement sweeps (see PRETIUM_SETTLEMENT_ADDRESS below).
# Optional only in the sense that startup won't fail without it — settlement
# will fail at runtime once a payout actually needs to sweep.
OPERATOR_PRIVATE_KEY=

# HD wallet mnemonic (12 words, BIP-39)
HD_MNEMONIC=

# 32-byte hex key for AES-256-GCM private key encryption
ENCRYPTION_KEY=

# JWT signing secret (min 32 chars)
JWT_SECRET=

# Settlement provider (fiat payout + FX rates)
PRETIUM_API_KEY=
PRETIUM_BASE_URL=
# On-chain address the settlement provider verifies incoming USDC against
# before releasing a fiat payout — get this from the provider directly.
PRETIUM_SETTLEMENT_ADDRESS=
PRETIUM_WEBHOOK_SECRET=
# Set true to skip real settlement calls during local dev
PRETIUM_SKIP_SETTLEMENT=false
# Public base URL of this backend — used to build the settlement webhook callback_url
PUBLIC_BASE_URL=https://your-backend.com

# Smart Contracts (Avalanche C-Chain)
PAYMENT_GATEWAY_ADDRESS=
MERCHANT_REGISTRY_ADDRESS=
DEPLOYER_ADDRESS=
