{
  "info": {
    "name": "AvaRamp API",
    "description": "USDC on Avalanche C-Chain → mobile money settlement across KES, NGN, GHS, TZS, UGX.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://avarampbackend.onrender.com" },
    { "key": "apiKey", "value": "avr_test_xxxxxxxx" },
    { "key": "bearerToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"changeme123\",\n  \"businessName\": \"My Store\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"changeme123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "item": [
        {
          "name": "Generate key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"My integration\",\n  \"mode\": \"test\"\n}" },
            "url": "{{baseUrl}}/api-keys"
          }
        },
        {
          "name": "List keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": "{{baseUrl}}/api-keys"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amountFiat\": \"500\",\n  \"fiatCurrency\": \"KES\",\n  \"reference\": \"Order #001\"\n}"
            },
            "url": "{{baseUrl}}/payments"
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/payments/:id"
          }
        },
        {
          "name": "List payments",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/payments?status=SETTLED&limit=20"
          }
        },
        {
          "name": "Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/payments/analytics"
          }
        },
        {
          "name": "Download settlement statement (CSV)",
          "request": {
            "method": "GET",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "url": "{{baseUrl}}/payments/statement"
          }
        }
      ]
    },
    {
      "name": "Settlements",
      "item": [
        {
          "name": "Trigger settlement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"paymentId\": \"pay_...\"\n}" },
            "url": "{{baseUrl}}/settlements"
          }
        }
      ]
    }
  ]
}
